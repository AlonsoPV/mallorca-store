PORT=8080
NODE_ENV=development

# Required: Postgres connection string (never commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Accept frontend Bearer local-dev token and upsert Admin Local user
# Never enable LOCAL_DEV_AUTH when NODE_ENV=production
LOCAL_DEV_AUTH=true
INITIAL_ADMIN_EMAIL=local-admin@mallorca.local
LOCAL_DEV_USER_ID=user_local_dev_admin
LOCAL_DEV_USER_EMAIL=local-admin@mallorca.local
LOCAL_DEV_USER_FIRST_NAME=Admin
LOCAL_DEV_USER_LAST_NAME=Local

# Optional real Clerk keys for non-local auth
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Comma-separated browser origins allowed with credentials.
# PUBLIC_APP_URL and STOREFRONT_PUBLIC_URL are also included automatically.
# CORS_ORIGINS=https://pasteleria-mallorca.mx,https://www.pasteleria-mallorca.mx

# 32-byte key for AES-256-GCM (hex, base64, or any passphrase hashed to 32 bytes).
# Required to store new payment/mailbox secrets. Legacy v1 values still decrypt without it.
# PAYMENT_SECRETS_KEY=

# SMTP — leave passwords empty in this file
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_ECOMM_USER=mallorcasistema@emotionsites.com
SMTP_ECOMM_PASS=
ORDER_EMAIL_FROM_SYSTEM=Mallorca Sistema <mallorcasistema@emotionsites.com>

SMTP_PEDIDOS_USER=pedidos@example.com
SMTP_PEDIDOS_PASS=
SMTP_SUCURSAL_USER=sucursal@example.com
SMTP_SUCURSAL_PASS=
ORDER_EMAIL_FROM=Mallorca <pedidos@example.com>
ORDER_EMAIL_FROM_BRANCH=Mallorca Sucursal <sucursal@example.com>
ORDER_EMAIL_REPLY_TO=Mallorca <contacto@example.com>
PUBLIC_APP_URL=http://localhost:5190
STOREFRONT_PUBLIC_URL=http://localhost:5190
APP_BASE_URL=

# Payments — leave empty until the merchant shares credentials. Sandbox stays on
# unless PAYMENT_ENVIRONMENT=live. Live is never implied.
PAYMENT_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
