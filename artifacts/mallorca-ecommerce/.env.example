# Development Clerk publishable key (pk_test_...). Optional on localhost.
# From Replit Auth pane or https://dashboard.clerk.com/~/api-keys
VITE_CLERK_PUBLISHABLE_KEY=

# Local Clerk stand-in (Admin Local). Auto-on when Clerk key is empty.
VITE_LOCAL_DEV_AUTH=true

# Only for deployed/custom-domain setups that proxy Clerk through the API.
# Leave unset on localhost.
# VITE_CLERK_PROXY_URL=/api/__clerk
